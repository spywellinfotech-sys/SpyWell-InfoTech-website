# Copy this file to .env for local development. Never commit .env.
# NOTE: every VITE_ variable is bundled into the public site. Put NO secret keys here.

# Your live site address (no trailing slash). Used for canonical URLs, Open Graph, sitemap.
VITE_SITE_URL=https://your-domain.example

# Form service endpoint (e.g. Formspree: https://formspree.io/f/xxxxxxx). Public endpoint ID only.
# Leave empty until configured: the form then offers WhatsApp/Email instead of claiming delivery.
VITE_FORM_ENDPOINT=
